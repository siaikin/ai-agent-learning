{
  "name": "my-harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A personal AI agent harness, built step by step following Learn Claude Code",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "s01": "tsx src/s01-agent-loop.ts",
    "s02": "tsx src/s02-tool-use.ts",
    "s03": "tsx src/s03-permission.ts",
    "s04": "tsx src/s04-hooks.ts",
    "s05": "tsx src/s05-todo.ts",
    "s06": "tsx src/s06-subagent.ts",
    "s07": "tsx src/s07-skills.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@langfuse/otel": "^6.1.1",
    "@langfuse/tracing": "^6.1.1",
    "@opentelemetry/sdk-node": "^0.223.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
