# 推荐用 `npm run setup` 通过表单生成 .env；也可以复制本文件为 .env 手动填写。
# .env 已在 .gitignore 中，不会被提交。
# 接口格式：Claude（Anthropic Messages API）。Anthropic 官方、Anthropic 兼容的服务、自己的中转都可以。
# LLM_BASE_URL 留空 = Anthropic 官方；填兼容服务时不要带 /v1/messages（SDK 会自动拼上）
LLM_BASE_URL=
LLM_API_KEY=sk-ant-xxxx
LLM_MODEL=claude-opus-5-5
# 单次回复的 token 上限；兼容服务的上限可能更低，报错时调小
LLM_MAX_TOKENS=16000

# 可选：Langfuse 可观测性（npm run setup -- langfuse 可以通过表单填写并测试）
# 区域：欧盟 https://cloud.langfuse.com · 美国 https://us.cloud.langfuse.com · 日本 https://jp.cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
